{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackDock Native Settings",
  "mainBinaryName": "StackDock",
  "version": "0.2.0-beta",
  "identifier": "com.stackdock.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StackDock",
        "width": 1100,
        "height": 720,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Stackdock by Tanveer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/settings.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}